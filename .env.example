# --- Backend 1: Google Gemini, direct (default) ---------------------------
# Key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional - override the model if the free tier runs out of quota
# GEMINI_MODEL=gemini-3.5-flash

# --- Backend 2: any OpenAI-compatible endpoint ----------------------------
# Set OPENAI_BASE_URL to switch to this backend, e.g. a local LiteLLM proxy.
# OPENAI_BASE_URL=http://localhost:4000/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=auto/best-fast
